# Copy to .env for local development (the server reads process.env directly).

# Postgres connection string. Local default if unset:
#   postgresql://vt:vt@127.0.0.1:5432/vendtap
DATABASE_URL=postgresql://vt:vt@127.0.0.1:5432/vendtap

# Secret used to sign JWTs. MUST be set to a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string

# Port the API/server listens on.
PORT=4000

# Set to 1 to auto-seed demo data on boot if the database is empty.
SEED_ON_START=0

# Sales tax applied to invoice subtotals (0 = tax-exempt resale).
TAX_RATE=0
